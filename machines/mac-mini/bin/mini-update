#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Install all macOS updates on the Mac Mini, restarting if required.

Usage: mini-update [--help]

MINI_HOST selects the SSH host (default: mini). There are no update flags;
the remote softwareupdate command installs all available updates.
USAGE
}

case ${1:-} in
  --help|-h) usage; exit 0 ;;
  '') ;;
  *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac
(( $# <= 1 )) || { usage >&2; exit 2; }

host=${MINI_HOST:-mini}
# This script body is intentionally expanded only by bash on the Mini.
# shellcheck disable=SC2016
remote='set -euo pipefail
fv=$(sudo fdesetup status 2>&1) || {
  echo "fdesetup status failed: $fv" >&2
  exit 21
}
if [[ $fv != *"FileVault is Off"* ]]; then
  echo "refusing to update: $fv (an unattended restart would strand at the FileVault prompt)" >&2
  exit 22
fi
echo "Installing all macOS updates; restarting if required."
sudo softwareupdate -i -a -R'

ssh -t "$host" "bash -c $(printf %q "$remote")"
