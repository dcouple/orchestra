<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dcouple.heartbeat</string>
  <key>Program</key>
  <string>/usr/local/libexec/dcouple/heartbeat.sh</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/var/log/dcouple-heartbeat.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/dcouple-heartbeat.log</string>
</dict>
</plist>
