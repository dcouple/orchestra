[Unit]
Description=Codex live (voice) app-server with remote control
After=network-online.target
Wants=network-online.target

[Service]
# `remote-control start` launches Codex's own managed app-server daemon and
# returns once it is up, so the unit is oneshot-and-stay-active rather than
# simple. The forked app-server stays in this unit's cgroup, which is what
# makes ExecStop and systemctl stop reach it.
Type=oneshot
RemainAfterExit=yes
User=linear-daemon
Group=linear-daemon
WorkingDirectory=/var/lib/linear-agent-daemon/live
EnvironmentFile=/etc/linear-agent-daemon/env
Environment=HOME=/var/lib/linear-agent-daemon
Environment=CODEX_HOME=/var/lib/linear-agent-daemon/.codex-live
# /opt/codex-live/bin is deliberately first and /usr/local/bin is deliberately
# absent: the latter holds the subagent Codex's otel wrapper, whose dispatch
# telemetry and env stripping are meaningless for a live session and whose
# pinned version differs.
Environment=PATH=/opt/codex-live/bin:/var/lib/linear-agent-daemon/.local/bin:/usr/bin:/bin
# The app-server self-updater inherits this and writes its launcher here rather
# than the ~/.local/bin default, which sits on the daemon's PATH. Belt to the
# PATH ordering in linear-agent-daemon.service: this stops the shadowing
# launcher being created, that stops it mattering if one ever is.
Environment=CODEX_INSTALL_DIR=/opt/codex-live/bin
# Clear state left by an abrupt teardown before starting. The managed daemon
# records its pid as JSON and refuses to start while that pid still exists —
# and a zombie counts as existing, so a reaped-but-unwaited app-server wedges
# every subsequent start with "app server did not become ready" while the
# control socket is gone. Reap what we can, then drop the stale records.
ExecStartPre=-/usr/bin/env sh -c 'p=$(sed -n "s/.*\\"pid\\":\\([0-9]*\\).*/\\1/p" "$CODEX_HOME/app-server-daemon/app-server.pid" 2>/dev/null); \
  if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null || [ "$(ps -o stat= -p "${p:-0}" 2>/dev/null | cut -c1)" = "Z" ]; then \
    rm -f "$CODEX_HOME/app-server-daemon/app-server.pid" \
          "$CODEX_HOME/app-server-control/app-server-control.sock"; \
  fi'
# Two steps rather than `remote-control start`, which is both at once: when
# enrolment fails this distinguishes "app-server did not come up" from "the
# relay refused us", which are different problems with different fixes.
ExecStart=/opt/codex-live/bin/codex app-server daemon start
ExecStart=/opt/codex-live/bin/codex app-server daemon enable-remote-control
ExecStop=/opt/codex-live/bin/codex app-server daemon stop
# The app-server manages its own lifetime and its own updater child. Letting
# systemd SIGKILL the cgroup on stop is what orphaned the updater loop and left
# a zombie behind it; ExecStop already asks it to shut down cleanly.
KillMode=process
# A self-update stops the app-server and can leave the control socket missing,
# which fails the next start. Retry rather than staying dead until someone
# notices the voice session is gone.
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
# Matches linear-agent-daemon.service: live turns run the same agent tooling,
# including browser engines that build sandboxes from these namespace kinds.
RestrictNamespaces=user pid net ipc uts cgroup
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service @sandbox unshare setns
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/linear-agent-daemon

[Install]
WantedBy=multi-user.target
