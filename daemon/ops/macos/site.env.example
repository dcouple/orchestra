# Site-specific settings for the macOS daemon host.
#
# This file holds the one deployment's identity — nothing here is secret, and
# nothing here belongs in orchestra. Keep the filled-in copy in the consumer
# repo's docs, pass it to the provisioner (`provision.sh --site <file>`), and
# the provisioner installs it at /usr/local/etc/linear-agent-daemon/site.env,
# where daemonctl, deploy.sh, and the launchd runners read it.
#
# Values are plain KEY=VALUE; no quoting, no shell expansion.

# Public hostname the Cloudflare Tunnel publishes the daemon at. Also the
# host in WEBHOOK_BASE_URL and both Linear webhook URLs.
DAEMON_PUBLIC_HOSTNAME=linear-agent.example.com

# Name given to `cloudflared tunnel create` / `tunnel route dns`.
DAEMON_TUNNEL_NAME=linear-agent

# Dedicated administrator account the services run as, and its home.
DAEMON_SERVICE_USER=linearagent
DAEMON_SERVICE_HOME=/Users/linearagent

# Reverse-DNS prefix for the launchd labels: <prefix>.linear-agent-daemon,
# <prefix>.cliproxyapi, <prefix>.cloudflared.
DAEMON_LAUNCHD_PREFIX=com.example

# HTTPS URL of the orchestra repository the persistent source checkout
# (daemonctl reload) pulls from. Point at a fork if you run one.
DAEMON_SOURCE_REPO_URL=https://github.com/dcouple/orchestra.git
